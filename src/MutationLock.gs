/**
 * 第四十三輪批次 A 組：**同一時間只可以有一個會改動資料的動作在跑。**
 *
 * ═════════════════════════════════════════════════════════════════════
 * 現場（Ivan 原話）
 * ═════════════════════════════════════════════════════════════════════
 *
 * > 我改了幾樣東西……然後撳「儲存我的修改」。等了一陣，畫面**好像重新
 * > 整理了**，我可以自由撳任何一粒掣。但再等三十幾秒，它**突然彈出**
 * > 「已儲存什麼」通知我儲存好了。這個等待空隙很容易令我誤撳其他掣，
 * > 或者再撳一次儲存。
 *
 * ─────────────────────────────────────────────────────────────────────
 * 為什麼畫面鎖住還不夠
 * ─────────────────────────────────────────────────────────────────────
 *
 * 畫面那一層（`setBusy()` ＋ `is-busy`）是第一道防線，但它**只是一道
 * 方便的閘**：重新整理一次瀏覽器、開多一個分頁、或者網絡慢到他以為
 * 撳不到而狂撳，都可以繞過去。
 *
 * 而繞過去的後果不是「多做一次」——是**兩個請求同時在改同一批資料**：
 *
 *   ・兩邊各自 `findLatestVersionNo()` 讀到同一個 v，
 *     然後各自建立 `Roster_..._v(N+1)` ⇒ 第二個 `insertSheet()` 撞名失敗，
 *     而第一個已經寫了一半 `RosterAssignments`
 *   ・或者兩個版本都建立成功，而 `RosterVersions` 有兩行 v(N+1)
 *
 * 兩種都要人手善後，而幹事完全不知道發生過什麼事。
 *
 * ─────────────────────────────────────────────────────────────────────
 * 做法：文件層的鎖，**拿不到就立刻拒絕**
 * ─────────────────────────────────────────────────────────────────────
 *
 * ⚠️ `tryLock(0)`——**不等**。
 *
 * 等（例如 `waitLock(30000)`）看起來比較「友善」，但實際後果更差：
 * 第二個請求會排隊排三十秒，然後在第一個做完之後**照樣執行一次**
 * ——即是他撳兩次就真的做兩次。而他撳第二次的原因，正正是他以為
 * 第一次沒有反應。
 *
 * 立刻拒絕 ＋ 一句講得明白的訊息，才是他真正需要的東西。
 *
 * ⚠️ 用 `getDocumentLock()` 而不是 `getScriptLock()`：這個系統一份試算表
 * 就是一套資料，鎖的範圍應該是那一份文件。`PdfFolders.gs` 那一個用
 * `getScriptLock()` 是另一件事（它保護的是「建資料夾」這個全域動作）。
 */

/** 拿不到鎖的時候等多久（毫秒）。**0 ＝ 不等**，理由見檔頭。 */
const MUTATION_LOCK_WAIT_MS = 0;

/**
 * 現在正在跑的那個動作叫什麼名（同一次執行之內有效）。
 *
 * ⚠️ 這個**不是**跨請求的狀態——Apps Script 每個請求各自一個
 * JavaScript 環境，所以它只用來擋「同一次執行入面互相叫」那種情況
 *（例如 `apiSaveAndConfirmExecute()` 入面又叫 `applyRequests_()`，
 * 而後者將來如果也包了鎖，就會自己鎖死自己）。
 */
let mutationLockDepth_ = 0;

/**
 * 包住一個會改動資料的動作。**拿不到鎖就拋一個三段式訊息。**
 *
 * @param {string} actionName 動作的人話名稱（會出現在訊息裡面）
 * @param {Function} fn 要跑的東西
 * @returns {*} `fn()` 的回傳值
 */
function withMutationLock_(actionName, fn) {
  // 已經喺鎖入面（同一次執行）⇒ 直接行，唔好自己鎖死自己。
  if (mutationLockDepth_ > 0) {
    mutationLockDepth_++;
    try {
      return fn();
    } finally {
      mutationLockDepth_--;
    }
  }

  const lock = LockService.getDocumentLock();
  let got = false;
  try {
    got = lock.tryLock(MUTATION_LOCK_WAIT_MS);
  } catch (err) {
    // ⚠️ 拿鎖本身出錯**不可以當成拿到了**。
    // 當成拿到就等於整個機制沒有生效，而畫面會一切正常。
    throw new Error(buildThreePartMessage_(
      '系統拿不到「同一時間只做一件事」那一把鎖（' + err.message + '）。',
      '「' + actionName + '」沒有開始，什麼都沒有改動。',
      ['等十秒再撳一次', '一直不行的話，把這一段訊息複製給開發者']));
  }

  if (!got) {
    throw new Error(buildThreePartMessage_(
      '另一個動作還在做緊，所以「' + actionName + '」沒有開始。',
      '什麼都沒有改動。上一個動作仍然在跑，它會自己做完。',
      ['等上一個動作做完（畫面中央那塊牌消失）再撳',
        '如果你剛才撳過兩次，那是正常的——系統只會做一次',
        '等超過兩分鐘都沒有反應，撳「重新整理」看看那一個動作有沒有做完']));
  }

  mutationLockDepth_++;
  try {
    return fn();
  } finally {
    mutationLockDepth_--;
    try {
      lock.releaseLock();
    } catch (err) {
      // 放鎖失敗唔可以蓋過原本嘅結果（或者原本嗰個錯）。
      // Apps Script 執行完會自動放，所以呢度只寫 log。
      log_('WARN', 'withMutationLock_ 放鎖失敗（' + actionName + '）：' + err.message);
    }
  }
}
